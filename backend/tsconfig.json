{
  "compilerOptions": {
    "target": "ES6",
    "experimentalDecorators": true,

    "typeRoots": [
      "./node_modules/@types",
      "./src/types"
    ],

    "module": "nodenext",
    "rootDir": "./src",
    "outDir": "./dist",

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "noImplicitAny": false,
    "strictPropertyInitialization": false,
    "skipLibCheck": true
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts"
  ],

  "ts-node": {
    "files": true
  }
}